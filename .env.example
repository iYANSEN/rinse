# Copy to .env (local) or add these in Vercel > Project Settings > Environment Variables.
LLM_API_KEY=
LLM_BASE_URL=https://api.freeaiapikey.com/v1
LLM_MODEL=anthropic/claude-sonnet-5
HOURLY_CAP=20
DAILY_CAP=300

# Hosted client links on Vercel need a place to keep photos. Free Upstash Redis works:
# (Vercel > Storage > Upstash Redis fills these in for you.) Locally, links are saved in ./data.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: SHARE_TTL_DAYS=180   PUBLIC_URL=https://your-domain.com
