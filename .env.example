# Copy to .env (local) or add these in Vercel > Project Settings > Environment Variables.
LLM_API_KEY=
LLM_BASE_URL=https://api.freeaiapikey.com/v1
LLM_MODEL=anthropic/claude-sonnet-5
HOURLY_CAP=20
DAILY_CAP=300

# Hosted client links need somewhere to keep photos. On Vercel, add a Blob store
# (Vercel > Storage > Blob) and it sets BLOB_READ_WRITE_TOKEN for you. Upstash Redis
# works too. Locally, links are saved in ./data.
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: SHARE_TTL_DAYS=180   PUBLIC_URL=https://your-domain.com
